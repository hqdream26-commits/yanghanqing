---
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getAuthorAvatarUrl } from "@/utils/schema-image";
import { buildProfilePage } from "@/utils/schema-utils";

const email = "15165883828@163.com";
const locationUrl =
	"https://map.baidu.com/search/%E5%B1%B1%E4%B8%9C%E4%BA%A4%E9%80%9A%E5%AD%A6%E9%99%A2(%E9%95%BF%E6%B8%85%E6%A0%A1%E5%8C%BA)/@13001812.676120263,4350156.516260751,17.42z,2.2h?querytype=s&da_src=shareurl&wd=%E5%B1%B1%E4%B8%9C%E4%BA%A4%E9%80%9A%E5%AD%A6%E9%99%A2(%E9%95%BF%E6%B8%85%E6%A0%A1%E5%8C%BA)&c=23&src=0&wd2=%E6%B5%8E%E5%8D%97%E5%B8%82%E9%95%BF%E6%B8%85%E5%8C%BA&pn=0&sug=1&l=9&b=(12956508.68238,3428963.58947;13488765.35479,3721877.06133)&from=webmap&biz_forward=%7B%22scaler%22:2,%22styles%22:%22pl%22%7D&sug_forward=e3082848a81364c2b34c49da&device_ratio=2";

const avatarUrl = await getAuthorAvatarUrl();
const jsonLd = buildProfilePage({
	site: siteConfig.site_url,
	profileConfig,
	authorUrl: Astro.url.toString(),
	avatarUrl,
	description: profileConfig.bio,
});
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<div class="flex w-full rounded-(--radius-large) overflow-visible relative min-h-32">
		<div class="card-base z-10 px-6 md:px-9 py-7 relative w-full">
			<section class="about-hero">
				<img
					src="/assets/images/profile/avatar-cat.jpg"
					alt="DreamHQ"
					class="about-avatar"
					loading="eager"
					decoding="async"
				/>
				<div class="min-w-0">
					<p class="about-kicker">你好，欢迎来到我的博客。</p>
					<h1>DreamHQ</h1>
					<p class="about-lead">
						我是一名关注 <strong>后端全栈、AI 应用、智能硬件和行业数字化</strong> 的实践者。比起只停留在概念层面，我更喜欢把一个想法拆成可运行的页面、接口、数据流和演示系统，看它真正跑起来。
					</p>
				</div>
			</section>

			<section class="about-copy">
				<p>
					我做过文旅管理系统、负碳建材生产线智能检测与维保平台、智能热成像测温模组，也一直在学习 Spring Boot、Vue、Python、大模型应用、云边协同和嵌入式开发。技术对我来说，不只是工具箱，更是一种把现实问题变得可解、可验证、可落地的方式。
				</p>
				<p>
					这个博客，首先是我记录生活的地方：项目复盘、学习路线、踩坑记录、方法论，也会有一些日常折腾和阶段性的思考。它不只是一个展示页，更像我的公开笔记本和会客厅。
				</p>
				<p>
					我也希望借这个博客，找到一些志同道合的朋友。如果你也在关注后端全栈、AI 应用、智能硬件、行业数字化，或者你只是单纯喜欢动手做点东西、愿意用技术解决真实问题，我们大概会有不少话可聊。欢迎交流、讨论、合作，或者只是互相打个招呼。
				</p>
				<p>
					我一直觉得，新时代的竞争力，不只是“会不会用某个工具”，而是能不能用 AI 和编程解决真实问题。如果你也认同，或者我们关注的方向有交集，很高兴在这里遇见你。
				</p>
			</section>

			<section class="contact-grid" aria-label="联系方式">
				<button class="contact-card" type="button" data-copy-email={email}>
					<span class="contact-icon"><Icon name="fa7-solid:envelope" /></span>
					<span>
						<strong>Email</strong>
						<small>{email}</small>
					</span>
					<em data-copy-label>悬停复制</em>
				</button>

				<div class="contact-card wechat-card" tabindex="0">
					<span class="contact-icon"><Icon name="fa7-brands:weixin" /></span>
					<span>
						<strong>微信</strong>
						<small>DreamHQ</small>
					</span>
					<em>悬停查看</em>
					<div class="wechat-popover" aria-label="微信二维码">
						<img src="/assets/images/about/wechat.png" alt="DreamHQ 微信二维码" loading="lazy" />
					</div>
				</div>

				<a class="contact-card" href={locationUrl} target="_blank" rel="noopener noreferrer">
					<span class="contact-icon"><Icon name="material-symbols:location-on-outline-rounded" /></span>
					<span>
						<strong>所在地</strong>
						<small>山东交通学院（长清校区）</small>
					</span>
					<em>打开地图</em>
				</a>

				<a class="contact-card" href="https://github.com/hqdream26-commits/yanghanqing" target="_blank" rel="noopener noreferrer">
					<span class="contact-icon"><Icon name="fa7-brands:github" /></span>
					<span>
						<strong>GitHub</strong>
						<small>hqdream26-commits</small>
					</span>
					<em>访问主页</em>
				</a>
			</section>

			<section class="focus-panel">
				<h2>我在做什么</h2>
				<div class="focus-grid">
					<div><strong>AI 应用</strong><span>Prompt 工程、RAG、开源模型问答助手</span></div>
					<div><strong>后端与全栈</strong><span>Spring Boot、Vue、数据库、部署运维</span></div>
					<div><strong>智能硬件</strong><span>STM32、红外阵列传感器、PCB、嵌入式固件</span></div>
					<div><strong>行业数字化</strong><span>边缘采集、工业协议、设备检测与故障预警</span></div>
				</div>
			</section>
		</div>
	</div>

	<script is:inline>
		document.addEventListener("DOMContentLoaded", () => {
			document.querySelectorAll("[data-copy-email]").forEach((button) => {
				let copied = false;
				const label = button.querySelector("[data-copy-label]");
				const copy = async () => {
					if (copied) return;
					copied = true;
					try {
						await navigator.clipboard.writeText(button.dataset.copyEmail || "");
						if (label) label.textContent = "已复制";
					} catch {
						if (label) label.textContent = "点击复制";
					}
					window.setTimeout(() => {
						copied = false;
						if (label) label.textContent = "悬停复制";
					}, 1600);
				};
				button.addEventListener("mouseenter", copy);
				button.addEventListener("focus", copy);
				button.addEventListener("click", copy);
			});
		});
	</script>
</MainGridLayout>

<style>
	.about-hero {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1.25rem;
		align-items: center;
		margin-bottom: 1.5rem;
	}

	.about-avatar {
		width: 6rem;
		height: 6rem;
		border-radius: 999px;
		object-fit: cover;
		border: 3px solid color-mix(in oklab, var(--primary) 55%, transparent);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
	}

	.about-kicker {
		margin: 0 0 0.35rem;
		color: var(--primary);
		font-weight: 700;
	}

	.about-hero h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1;
		letter-spacing: 0;
	}

	.about-lead,
	.about-copy p {
		color: rgb(var(--text-p3));
		line-height: 1.9;
	}

	.about-lead {
		margin: 0.65rem 0 0;
		font-size: 1rem;
	}

	.about-copy {
		display: grid;
		gap: 0.9rem;
		margin: 1.5rem 0;
	}

	.about-copy p {
		margin: 0;
	}

	.contact-grid {
		position: relative;
		z-index: 30;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
		gap: 0.85rem;
		margin: 1.75rem 0;
	}

	.contact-card {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.85rem;
		min-height: 4.75rem;
		padding: 0.95rem;
		border: 1px solid var(--line-divider);
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.56);
		color: inherit;
		text-align: left;
		text-decoration: none;
		transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
	}

	button.contact-card {
		width: 100%;
		font: inherit;
		cursor: pointer;
	}

	:global(:root.dark) .contact-card {
		background: rgba(20, 20, 24, 0.45);
	}

	.wechat-card {
		z-index: 40;
	}

	.contact-card:hover,
	.contact-card:focus-visible {
		border-color: color-mix(in oklab, var(--primary) 65%, transparent);
		transform: translateY(-1px);
		outline: none;
	}

	.wechat-card:hover,
	.wechat-card:focus,
	.wechat-card:focus-within {
		z-index: 9999;
	}

	.contact-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.65rem;
		background: color-mix(in oklab, var(--primary) 16%, transparent);
		color: var(--primary);
		font-size: 1.25rem;
	}

	.contact-card strong,
	.contact-card small {
		display: block;
		min-width: 0;
	}

	.contact-card strong {
		font-size: 0.95rem;
	}

	.contact-card small {
		margin-top: 0.15rem;
		color: rgb(var(--text-p3));
		overflow-wrap: anywhere;
	}

	.contact-card em {
		font-style: normal;
		font-size: 0.75rem;
		color: var(--primary);
		white-space: nowrap;
	}

	.wechat-popover {
		position: absolute;
		right: 0.85rem;
		top: calc(100% + 0.65rem);
		z-index: 10000;
		width: min(18rem, calc(100vw - 2rem));
		padding: 0.65rem;
		border-radius: 0.85rem;
		background: white;
		box-shadow: 0 22px 55px rgba(0, 0, 0, 0.22);
		opacity: 0;
		pointer-events: none;
		transform: translateY(-0.35rem);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	:global(:root.dark) .wechat-popover {
		background: rgb(24, 24, 28);
	}

	.wechat-popover img {
		display: block;
		width: 100%;
		max-height: min(70vh, 32rem);
		height: auto;
		object-fit: contain;
		border-radius: 0.5rem;
	}

	.wechat-card:hover .wechat-popover,
	.wechat-card:focus .wechat-popover,
	.wechat-card:focus-within .wechat-popover {
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0);
	}

	.focus-panel {
		margin-top: 1.75rem;
		padding-top: 1.35rem;
		border-top: 1px solid var(--line-divider);
	}

	.focus-panel h2 {
		margin: 0 0 1rem;
		font-size: 1.3rem;
	}

	.focus-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0.85rem;
	}

	.focus-grid div {
		padding: 1rem;
		border-radius: 0.75rem;
		background: color-mix(in oklab, var(--primary) 8%, transparent);
	}

	.focus-grid strong,
	.focus-grid span {
		display: block;
	}

	.focus-grid span {
		margin-top: 0.45rem;
		color: rgb(var(--text-p3));
		line-height: 1.65;
	}

	@media (max-width: 640px) {
		.about-hero {
			grid-template-columns: 1fr;
		}

		.about-avatar {
			width: 5rem;
			height: 5rem;
		}

		.contact-card {
			grid-template-columns: auto minmax(0, 1fr);
		}

		.contact-card em {
			grid-column: 2;
		}
	}
</style>
